# Copy to .env.local and fill in. Never commit .env.local.

# Required (Phase 1+): Anthropic API key, used only by server-side API routes.
ANTHROPIC_API_KEY=

# Phase 2: ElevenLabs text-to-speech (optional: falls back to browser speech if unset).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Phase 5: access code users must enter before using the app.
ACCESS_CODE=

# Phase 5 (optional): Upstash Redis for rate limiting. In-memory fallback if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
