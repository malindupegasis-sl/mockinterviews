# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables. Never commit real values.

# REQUIRED. Anthropic API key (used only by server-side API routes).
ANTHROPIC_API_KEY=

# REQUIRED in production. The code people type to use the app.
# Change it (and redeploy) to cut off everyone who has the old code.
ACCESS_CODE=

# REQUIRED in production. Random secret used to sign interview turn records so the
# browser can't tamper with them. At least 16 characters, e.g. generate one with:
#   openssl rand -base64 32
TURN_SECRET=

# Optional: ElevenLabs text-to-speech. Used only if BOTH are set; otherwise browser speech.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: Upstash Redis for rate limiting (5 interviews per IP per day).
# Without it, an in-memory limiter is used (per server instance, resets on restart).
# Vercel's Upstash integration names these KV_REST_API_URL / KV_REST_API_TOKEN; both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
